# Dependencies
node_modules/
# Lockfile is not committed: local `npm install` bakes in an internal registry
# (~/.npmrc → npm.apple.com) that GitHub's cloud runners can't reach. CI runs
# `npm install` fresh from the public registry instead.
package-lock.json

# Build output (generated from recipes/ by build.mjs; CI rebuilds on deploy)
*.html

# Importer (tools/) — venv, sheet exports, generated reports
tools/.venv/
tools/import-failures.txt
tools/needs-review.txt

# macOS / Python cruft
.DS_Store
__pycache__/
*.pyc
